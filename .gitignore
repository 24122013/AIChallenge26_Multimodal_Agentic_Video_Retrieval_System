
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
.env

# Ultralytics may materialize these official YOLOE assets in the process cwd.
# The ingestion backend uses data/model_cache, but keep old/new library
# versions from invalidating immutable-run Git fingerprints.
/yoloe-*.pt
/mobileclip*.ts

# Local/public competition datasets and generated submissions.
data/public/
data/competition/

data/raw/video/
data/raw/*.zip
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/embeddings/
data/indexes/
data/model_cache/
data/smoke/
data/keyframes/*
!data/keyframes/.gitkeep
data/keyframes_*/
data/metadata/*
!data/metadata/.gitkeep

# Generated artifacts from the public competition adapter.
competition/keyframes/*
!competition/keyframes/.gitkeep
competition/metadata/*
!competition/metadata/.gitkeep
competition/embeddings/*
!competition/embeddings/.gitkeep
competition/indexes/*
!competition/indexes/.gitkeep
competition/results/*
!competition/results/.gitkeep
competition/evaluation/*
!competition/evaluation/.gitkeep
competition/work/*
!competition/work/.gitkeep
competition/runs/*
!competition/runs/.gitkeep

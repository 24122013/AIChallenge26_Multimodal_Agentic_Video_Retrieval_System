
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
.env

# Ultralytics may materialize these official YOLOE assets in the process cwd.
# The ingestion backend uses data/model_cache, but keep old/new library
# versions from invalidating immutable-run Git fingerprints.
/yoloe-*.pt
/mobileclip*.ts

# Local datasets and generated runtime artifacts.
data/public/

data/raw/video/*
!data/raw/video/.gitkeep
data/raw/*.zip
data/**/*.jpg
data/**/*.jpeg
data/**/*.png
data/embeddings/*
!data/embeddings/.gitkeep
data/indexes/*
!data/indexes/.gitkeep
data/model_cache/*
!data/model_cache/.gitkeep
data/smoke/
data/keyframes/*
!data/keyframes/.gitkeep
data/keyframes_*/
data/metadata/*
!data/metadata/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/submissions/*
!data/submissions/.gitkeep
data/reports/*
!data/reports/.gitkeep

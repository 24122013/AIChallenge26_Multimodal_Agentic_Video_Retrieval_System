
.pytest_cache/
.venv/
__pycache__/
*.py[cod]
.env

# Ultralytics may materialize these official YOLOE assets in the process cwd.
# The ingestion backend uses data/model_cache, but keep old/new library
# versions from invalidating immutable-run Git fingerprints.
/yoloe-*.pt
/mobileclip*.ts

# Local datasets and generated runtime artifacts. Keep only documentation and
# directory placeholders under version control; this also covers new offline
# workspaces such as candidates/, candidate_features/, and dense_keyframes/.
/data/**
!/data/**/
!/data/README.md
!/data/**/.gitkeep

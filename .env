# Canonical repository configuration. All backend entry points load this file.
# Keep secrets in process-level environment variables; they override these values.

# Core retrieval artifacts
RETRIEVAL_CONFIG_PATH=configs/retrieval.yaml
RETRIEVAL_INDEX_PATH=data/indexes/siglip2_so400m_patch16_384_flat_ip.faiss
RETRIEVAL_FRAME_MAP_PATH=data/metadata/siglip2_so400m_patch16_384_frame_map.json
RETRIEVAL_MANIFEST_PATH=data/metadata/siglip2_so400m_patch16_384_faiss_manifest.json
RETRIEVAL_DENSE_INDEX_PATH=data/indexes/siglip2_so400m_patch16_384_dense_flat_ip.faiss
RETRIEVAL_DENSE_METADATA_PATH=data/metadata/siglip2_so400m_patch16_384_dense_faiss_metadata.jsonl
RETRIEVAL_DENSE_FRAME_MAP_PATH=data/metadata/siglip2_so400m_patch16_384_dense_frame_map.json
RETRIEVAL_DENSE_MANIFEST_PATH=data/metadata/siglip2_so400m_patch16_384_dense_faiss_manifest.json
RETRIEVAL_DENSE_REPORT_PATH=data/metadata/siglip2_so400m_patch16_384_dense_index_report.json
RETRIEVAL_TEXT_INDEX_PATH=data/indexes/retrieval_text_index.json
RETRIEVAL_CORPUS_MANIFEST_PATH=data/metadata/offline_corpus_manifest.json
RETRIEVAL_MODELS_LOCAL_ONLY=true
RETRIEVAL_DEVICE=cuda
RETRIEVAL_MODEL_CACHE_DIR=data/model_cache/siglip2
RETRIEVAL_NO_AUTOCAST=false
RETRIEVAL_DEFAULT_TOP_K=20
RETRIEVAL_MAX_TOP_K=200
RETRIEVAL_QUERY_EXPANSION_ENABLED=true
RETRIEVAL_QUERY_EXPANSION_MODEL_NAME=Qwen/Qwen3.5-2B
RETRIEVAL_QUERY_EXPANSION_MODEL_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
RETRIEVAL_QUERY_EXPANSION_QUANTIZATION=4bit
QUERY_EXPANSION_DEVICE=cuda

# Online dense retrieval. These become usable after the matching DATA bundle is published.
RETRIEVAL_ONLINE_COARSE_TO_DENSE_ENABLED=true
RETRIEVAL_ONLINE_DENSE_ENABLED=true
RETRIEVAL_ONLINE_DENSE_MISSING_BEHAVIOR=fallback_sparse
RETRIEVAL_ONLINE_DEBUG_ENABLED=false
SUBMISSION_OUTPUT_DIR=data/submissions

# Canonical context artifacts
NEIGHBOR_FRAME_PATH=data/metadata/neighbors_all.jsonl
ONLINE_NEIGHBOR_CONTEXT_ENABLED=true
ONLINE_SEGMENT_CONTEXT_ENABLED=true
ONLINE_NEIGHBOR_PATH=data/metadata/neighbors_all.jsonl
ONLINE_SEGMENT_PATH=data/metadata/segments_all.jsonl
RETRIEVAL_ONLINE_NEIGHBOR_SCORING_ENABLED=true
RETRIEVAL_ONLINE_SEGMENT_SCORING_ENABLED=true
RETRIEVAL_ONLINE_MAX_NEIGHBORS_EACH_SIDE=2
RETRIEVAL_ONLINE_SEGMENT_CONTEXT_CANDIDATE_LIMIT=12
RETRIEVAL_ONLINE_SEGMENT_CONTEXT_TOP_K=3
RETRIEVAL_ONLINE_CONTEXT_MAX_BONUS=0.08

# TRAKE. Dense BGE retrieval is allowed; learned/model reranking is disabled.
RETRIEVAL_TRAKE_VIDEO_ROOT=data/raw/video
RETRIEVAL_KEYFRAME_ROOT=data/keyframes
RETRIEVAL_TRAKE_BGE_DENSE_ENABLED=true
RETRIEVAL_TRAKE_BGE_DENSE_TOP_K=300
RETRIEVAL_TRAKE_BGE_RERANKER_ENABLED=false
RETRIEVAL_TRAKE_BGE_RERANKER_TOP_K=150
RETRIEVAL_TRAKE_RETRIEVAL_FUSION=rrf
RETRIEVAL_TRAKE_RRF_K=60
RETRIEVAL_TRAKE_HYBRID_RRF_WEIGHT=1.0
RETRIEVAL_TRAKE_BGE_RRF_WEIGHT=1.0
RETRIEVAL_TRAKE_BGE_REQUIRED=false
RETRIEVAL_TRAKE_BGE_INDEX_ROOT=data/indexes/bge_m3
RETRIEVAL_TRAKE_BGE_MODEL_NAME=BAAI/bge-m3
RETRIEVAL_TRAKE_BGE_MODEL_REVISION=
RETRIEVAL_TRAKE_BGE_BATCH_SIZE=16
RETRIEVAL_TRAKE_BGE_DEVICE=auto
RETRIEVAL_TRAKE_BGE_MODEL_CACHE_DIR=data/model_cache/bge_m3
RETRIEVAL_TRAKE_BGE_LOCAL_FILES_ONLY=true

# Caption model used by offline processing
CAPTION_MODEL=florence-community/Florence-2-base-ft
CAPTION_MODEL_REVISION=0b03b6f15a4a211370fb204aee4e7dd48887ea37
CAPTION_MODEL_CACHE_DIR=data/model_cache/caption

# QA routing and deterministic/constraint reranking
QA_TYPED_PARSER_ENABLED=true
QA_ROUTER_ENABLED=true
QA_EVIDENCE_BUNDLE_ENABLED=true
QA_PER_MODALITY_LIMIT=100
QA_RERANK_POOL_SIZE=100
QA_FUSION_POOL_SIZE=100
QA_EVIDENCE_LIMIT=100
QA_CONSTRAINT_RERANK_ENABLED=true
QA_TEMPORAL_ROUTING_ENABLED=true
QA_TEMPORAL_MAX_EVENTS=5
QA_TEMPORAL_MAX_GAP_SECONDS=180

# QA dense evidence retrieval. BGE-M3 is an embedding model, not a reranker.
QA_BGE_DENSE_ENABLED=true
QA_BGE_INDEX_ROOT=data/indexes/bge_m3
QA_BGE_MODEL_REVISION=
QA_BGE_RERANKER_ENABLED=false
QA_BGE_BATCH_SIZE=16
QA_BGE_DEVICE=auto
QA_BGE_MODEL_CACHE_DIR=data/model_cache/bge_m3
QA_MODELS_LOCAL_ONLY=true

# QA answer generation is optional; QA retrieval and manual frame selection remain active.
QA_ANSWER_MODE=off
QA_ANSWER_MODEL=Qwen/Qwen3.5-2B
QA_ANSWER_MODEL_REVISION=15852e8c16360a2fea060d615a32b45270f8a8fc
QA_ANSWER_DEVICE=cuda
QA_ANSWER_QUANTIZATION=auto
QA_ANSWER_MODEL_CACHE_DIR=data/model_cache/qa_answer
QA_ANSWER_CACHE_DIR=data/cache/qa_answers
QA_ANSWER_TIMEOUT_SECONDS=120

# Reference only: this repository does not automatically load .env files.
RETRIEVAL_CONFIG_PATH=configs/retrieval.yaml
RETRIEVAL_INDEX_PATH=data/indexes/siglip2_so400m_patch16_384_flat_ip.faiss
RETRIEVAL_FRAME_MAP_PATH=data/metadata/siglip2_so400m_patch16_384_frame_map.json
RETRIEVAL_MANIFEST_PATH=data/metadata/siglip2_so400m_patch16_384_faiss_manifest.json
RETRIEVAL_TEXT_INDEX_PATH=data/indexes/retrieval_text_index.json
RETRIEVAL_DEVICE=auto
RETRIEVAL_MODEL_CACHE_DIR=data/model_cache/siglip2
RETRIEVAL_NO_AUTOCAST=false
RETRIEVAL_DEFAULT_TOP_K=20
RETRIEVAL_MAX_TOP_K=200
SUBMISSION_OUTPUT_DIR=data/submissions

CAPTION_MODEL=Qwen/Qwen3-VL-8B-Instruct
CAPTION_MODEL_REVISION=b5bc35aa2d1dc2db88ca1482375afc801511bffb
CAPTION_MODEL_CACHE_DIR=data/model_cache/caption

QA_TYPED_PARSER_ENABLED=true
QA_ROUTER_ENABLED=true
QA_EVIDENCE_BUNDLE_ENABLED=true
QA_CONSTRAINT_RERANK_ENABLED=true
QA_TEMPORAL_ROUTING_ENABLED=true
QA_TEMPORAL_MAX_EVENTS=5
QA_TEMPORAL_MAX_GAP_SECONDS=180

QA_BGE_DENSE_ENABLED=false
QA_BGE_INDEX_ROOT=data/indexes/bge_m3
QA_BGE_MODEL_REVISION=main
QA_BGE_RERANKER_ENABLED=false
QA_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QA_BGE_RERANKER_REVISION=main
QA_BGE_RERANKER_ALPHA=0.5
QA_BGE_BATCH_SIZE=16
QA_BGE_DEVICE=auto
QA_BGE_MODEL_CACHE_DIR=data/model_cache/bge
QA_MODELS_LOCAL_ONLY=false

QA_ANSWER_MODE=off
QA_ANSWER_MODEL=Qwen/Qwen3.5-9B
QA_ANSWER_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
QA_ANSWER_DEVICE=auto
QA_ANSWER_QUANTIZATION=auto
QA_ANSWER_MODEL_CACHE_DIR=data/model_cache/qa
QA_ANSWER_CACHE_DIR=data/cache/qa_answers
QA_ANSWER_TIMEOUT_SECONDS=120

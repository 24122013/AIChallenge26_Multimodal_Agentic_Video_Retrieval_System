# Copy this file to `.env`. Retrieval CLI entrypoints automatically load `.env`;
# variables already set by the shell or process manager take precedence.
RETRIEVAL_CONFIG_PATH=configs/retrieval.yaml
RETRIEVAL_INDEX_PATH=data/indexes/siglip2_so400m_patch16_384_flat_ip.faiss
RETRIEVAL_FRAME_MAP_PATH=data/metadata/siglip2_so400m_patch16_384_frame_map.json
RETRIEVAL_MANIFEST_PATH=data/metadata/siglip2_so400m_patch16_384_faiss_manifest.json
RETRIEVAL_TEXT_INDEX_PATH=data/indexes/retrieval_text_index.json
RETRIEVAL_DEVICE=cuda
RETRIEVAL_MODEL_CACHE_DIR=data/model_cache/siglip2
RETRIEVAL_NO_AUTOCAST=false
RETRIEVAL_DEFAULT_TOP_K=20
RETRIEVAL_MAX_TOP_K=200
RETRIEVAL_QUERY_EXPANSION_ENABLED=false
SUBMISSION_OUTPUT_DIR=data/submissions

# Canonical original-video root used only by bounded TRAKE local refinement.
RETRIEVAL_TRAKE_VIDEO_ROOT=data/raw/video

# Optional TRAKE BGE-M3 candidate recall and event reranking. These settings
# are intentionally independent from QA_BGE_* and default to a safe fallback.
RETRIEVAL_TRAKE_BGE_DENSE_ENABLED=false
RETRIEVAL_TRAKE_BGE_DENSE_TOP_K=300
RETRIEVAL_TRAKE_BGE_RERANKER_ENABLED=false
RETRIEVAL_TRAKE_BGE_RERANKER_TOP_K=150
RETRIEVAL_TRAKE_RETRIEVAL_FUSION=rrf
RETRIEVAL_TRAKE_RRF_K=60
RETRIEVAL_TRAKE_HYBRID_RRF_WEIGHT=1.0
RETRIEVAL_TRAKE_BGE_RRF_WEIGHT=1.0
RETRIEVAL_TRAKE_BGE_REQUIRED=false
RETRIEVAL_TRAKE_BGE_INDEX_ROOT=data/indexes/bge_m3
RETRIEVAL_TRAKE_BGE_MODEL_NAME=BAAI/bge-m3
# Blank trusts the immutable model revision recorded in the committed index.
RETRIEVAL_TRAKE_BGE_MODEL_REVISION=
RETRIEVAL_TRAKE_BGE_BATCH_SIZE=16
RETRIEVAL_TRAKE_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# `main` is allowed only for optional/dev. Required mode needs an exact commit.
RETRIEVAL_TRAKE_BGE_RERANKER_REVISION=main
RETRIEVAL_TRAKE_BGE_RERANKER_ALPHA=0.5
RETRIEVAL_TRAKE_BGE_RERANKER_BATCH_SIZE=16
RETRIEVAL_TRAKE_BGE_DEVICE=auto
RETRIEVAL_TRAKE_BGE_MODEL_CACHE_DIR=data/model_cache/bge_m3
RETRIEVAL_TRAKE_BGE_LOCAL_FILES_ONLY=false

# Canonical online context stays opt-in until neighbor/segment ablations pass.
ONLINE_NEIGHBOR_CONTEXT_ENABLED=false
ONLINE_SEGMENT_CONTEXT_ENABLED=false
ONLINE_NEIGHBOR_PATH=data/metadata/neighbors_all.jsonl
ONLINE_SEGMENT_PATH=data/metadata/segments_all.jsonl

CAPTION_MODEL=Qwen/Qwen3-VL-8B-Instruct
CAPTION_MODEL_REVISION=b5bc35aa2d1dc2db88ca1482375afc801511bffb
CAPTION_MODEL_CACHE_DIR=data/model_cache/caption

QA_TYPED_PARSER_ENABLED=true
QA_ROUTER_ENABLED=true
QA_EVIDENCE_BUNDLE_ENABLED=true
QA_CONSTRAINT_RERANK_ENABLED=true
QA_TEMPORAL_ROUTING_ENABLED=true
QA_TEMPORAL_MAX_EVENTS=5
QA_TEMPORAL_MAX_GAP_SECONDS=180

QA_BGE_DENSE_ENABLED=false
QA_BGE_INDEX_ROOT=data/indexes/bge_m3
# Leave dense revision empty to trust the immutable revision recorded in the
# validated BGE manifest. Set it only to that exact resolved commit.
QA_BGE_MODEL_REVISION=
QA_BGE_RERANKER_ENABLED=false
QA_BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QA_BGE_RERANKER_REVISION=main
QA_BGE_RERANKER_ALPHA=0.5
QA_BGE_BATCH_SIZE=16
QA_BGE_DEVICE=auto
QA_BGE_MODEL_CACHE_DIR=data/model_cache/bge_m3
QA_MODELS_LOCAL_ONLY=false

QA_ANSWER_MODE=off
QA_ANSWER_MODEL=Qwen/Qwen3.5-9B
QA_ANSWER_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
QA_ANSWER_DEVICE=auto
QA_ANSWER_QUANTIZATION=auto
QA_ANSWER_MODEL_CACHE_DIR=data/model_cache/qa
QA_ANSWER_CACHE_DIR=data/cache/qa_answers
QA_ANSWER_TIMEOUT_SECONDS=120
